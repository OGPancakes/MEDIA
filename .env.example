# Reference only: app.py does not automatically load .env files.
# Set environment variables in your terminal or deployment settings.
# Keep real values private. Never use an exposed/shared password.
DATA_DIR=.local-data
SECRET_KEY=

# Optional: create an administrator only if one does not already exist.
# Existing administrator passwords must never be reset at startup.
PIA_INITIAL_ADMIN_PASSWORD=
PIA_INITIAL_ADMIN_EMAIL=developer@example.invalid

# Optional private seed-account import; disabled when no password is supplied.
IMPORTED_USER_PASSWORD=
TEMPORARY_USER_PASSWORD=
LEGACY_TEMPORARY_USER_PASSWORDS=

# APNs: provide a private key outside the repository, or a private environment value.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY_PATH=
APNS_BUNDLE_ID=com.piasocial.app
APNS_USE_SANDBOX=1
